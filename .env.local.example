# Google Sheets lead capture — example configuration.
# Copy to .env.local and fill in your own values:  cp .env.local.example .env.local
# The site runs without these set; the contact form falls back to demo mode.

# ID from your spreadsheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
LEADS_SHEET_ID=

# Tab to write to. Created automatically if it doesn't exist.
LEADS_SHEET_TAB=Leads

# Service account email that has edit access to the spreadsheet.
GOOGLE_CLIENT_EMAIL=

# Full PEM key from the service account JSON, quotes preserved.
# Literal \n sequences are converted to real newlines by the API route.
GOOGLE_PRIVATE_KEY=